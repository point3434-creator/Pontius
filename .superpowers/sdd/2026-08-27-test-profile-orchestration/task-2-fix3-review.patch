+            messages: list[str] = []
+            while pending:
+                current = pending.pop()
+                if id(current) in seen:
+                    continue
+                seen.add(id(current))
+                messages.append(str(current))
+                cause = current.__cause__
+                if cause is not None:
+                    pending.append(cause)
+                pending.extend(getattr(current, "exceptions", ()))
