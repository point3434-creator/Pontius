+                outcomes.update(_outer_loop_control_outcomes(case.body))
+        elif isinstance(statement, (ast.For, ast.AsyncFor, ast.While)):
+            # Break/continue in a nested loop do not target the outer loop.
+            outcomes.add("fallthrough")
