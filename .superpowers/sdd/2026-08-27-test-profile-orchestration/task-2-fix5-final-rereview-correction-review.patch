+    def _final_rereview_preclassifier_exhausts_irrefutable_match(self) -> None:
+        module = ast.parse(
+            textwrap.dedent(
+                """
+                import cupy as cp
+                def reviewed(subject):
+                    protected = cp
+                    match subject:
+                        case _:
+                            protected = None
+                    protected.arange()
+                """
+            )
+        )
+        function = next(
+            node for node in module.body if isinstance(node, ast.FunctionDef)
+        )
+        calls = self.generator._preclassified_sensitive_calls(
+            function.body,
+            {"cp": "cupy"},
+            self.generator._AnalysisBudget(),
+            {},
+        )
+        following = next(
+            node
+            for node in ast.walk(function)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and node.func.attr == "arange"
+        )
+        self.assertNotIn(id(following), calls)
+
+    def _final_rereview_preclassifier_uses_throw_site_handler_state(self) -> None:
+        module = ast.parse(
+            textwrap.dedent(
+                """
+                import cupy as cp
+                def reviewed():
+                    protected = cp
+                    try:
+                        protected = None
+                        raise RuntimeError()
+                    except RuntimeError:
+                        protected.arange()
+                """
+            )
+        )
+        function = next(
+            node for node in module.body if isinstance(node, ast.FunctionDef)
+        )
+        calls = self.generator._preclassified_sensitive_calls(
