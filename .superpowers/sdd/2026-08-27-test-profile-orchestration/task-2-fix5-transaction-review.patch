+            return_value=True,
+        ):
+            with self.assertRaisesRegex(Exception, "Git launch lease cleanup"):
+                lease.close()
+            second_ancestor_allowed = True
+            lease.close()
+            lease.close()
+        self.assertEqual(descriptor_closes, 1)
+        self.assertEqual(ancestor_closes, {201: 1, 202: 2})
