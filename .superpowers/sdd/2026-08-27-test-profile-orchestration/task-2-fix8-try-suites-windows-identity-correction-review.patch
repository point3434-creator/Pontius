+            "typed_handler": (
+                "value = cp\n"
+                "with contextlib.suppress(RuntimeError):\n"
+                "    try:\n"
+                "        may_raise()\n"
+                "    except RuntimeError:\n"
+                "        value = None\n"
+                "    else:\n"
+                "        value = None\n"
+                "value.arange(1)"
+            ),
